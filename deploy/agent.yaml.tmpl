# Pod template shared by every agent. scripts/agent-deploy.sh fills in the @@PLACEHOLDERS@@.
#
# One Pod, two containers, two owners:
#   agent        the application artifact: code + dependencies + launch.json, nothing else.
#                Brewlet supplies the language runtime (@@RUNTIME@@) chosen by the annotation below.
#   copilot-cli  an ordinary OCI sidecar that runs the Copilot CLI. It is the only container that
#                holds GitHub credentials; the agent reaches it over the Pod's loopback interface.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: @@AGENT@@
  namespace: @@NAMESPACE@@
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: @@AGENT@@
  namespace: @@NAMESPACE@@
  labels:
    app.kubernetes.io/name: @@AGENT@@
    app.kubernetes.io/part-of: brewlet-agents
  annotations:
    # Ask the Brewlet operator to roll this Deployment when Ops rotates the runtime image.
    brewlet.sh/restart-on-rotation: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: @@AGENT@@
  template:
    metadata:
      labels:
        app.kubernetes.io/name: @@AGENT@@
        app.kubernetes.io/part-of: brewlet-agents
        brewlet-agents.dev/language: @@LANGUAGE@@
      annotations:
        # The suffix is the container name: this container runs on the platform-owned runtime.
        runtime-image.brewlet.sh/agent: @@RUNTIME@@
    spec:
      runtimeClassName: brewlet
      serviceAccountName: @@AGENT@@
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 20
      nodeSelector:
        kubernetes.io/arch: @@ARCH@@
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        # A native sidecar: starts before the agent and lives as long as the Pod.
        - name: copilot-cli
          image: @@SIDECAR@@
          restartPolicy: Always
          env:
            # The SDK must present this token; the CLI refuses connections without it.
            - name: COPILOT_CONNECTION_TOKEN
              valueFrom:
                secretKeyRef:
                  name: @@SECRET@@
                  key: connection-token
            # Optional: absent until 'make auth', in which case the CLI starts unauthenticated.
            - name: COPILOT_GITHUB_TOKEN
              valueFrom:
                secretKeyRef:
                  name: @@SECRET@@
                  key: github-token
                  optional: true
          resources:
            requests:
              cpu: 50m
              memory: @@SIDECAR_MEMORY_REQUEST@@
            limits:
              memory: @@SIDECAR_MEMORY_LIMIT@@
          securityContext:
            runAsNonRoot: true
            runAsUser: 65532
            runAsGroup: 65532
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: cli-tmp
              mountPath: /tmp
      containers:
        - name: agent
          # Pinned by digest: Brewlet only runs immutable application images.
          image: @@ARTIFACT@@
          ports:
            - name: http
              containerPort: @@PORT@@
          env:
            - name: PORT
              value: "@@PORT@@"
            - name: AGENT_NAME
              value: @@AGENT@@
            - name: AGENT_RUNTIME_ID
              value: @@RUNTIME@@
            - name: COPILOT_CLI_URL
              value: 127.0.0.1:@@SIDECAR_PORT@@
            - name: COPILOT_CONNECTION_TOKEN
              valueFrom:
                secretKeyRef:
                  name: @@SECRET@@
                  key: connection-token
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          resources:
            requests:
              cpu: @@CPU_REQUEST@@
              memory: @@MEMORY_REQUEST@@
            limits:
              memory: @@MEMORY_LIMIT@@
          securityContext:
            # Brewlet's admission fills in the runtime's approved uid/gid; this keeps the manifest
            # compliant with Pod Security "restricted" before that happens.
            runAsNonRoot: true
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: agent-tmp
              mountPath: /tmp
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 2
            failureThreshold: 90
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            periodSeconds: 5
            failureThreshold: 3
      volumes:
        - name: agent-tmp
          emptyDir:
            sizeLimit: 64Mi
        - name: cli-tmp
          emptyDir:
            sizeLimit: 128Mi
---
apiVersion: v1
kind: Service
metadata:
  name: @@AGENT@@
  namespace: @@NAMESPACE@@
  labels:
    app.kubernetes.io/name: @@AGENT@@
    app.kubernetes.io/part-of: brewlet-agents
spec:
  selector:
    app.kubernetes.io/name: @@AGENT@@
  ports:
    - name: http
      port: 80
      targetPort: http
