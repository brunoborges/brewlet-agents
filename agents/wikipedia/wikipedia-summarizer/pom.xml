<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.github.brunoborges.brewletagents</groupId>
  <artifactId>wikipedia-summarizer</artifactId>
  <version>1.0.0</version>
  <name>Wikipedia summarizer (Spring Boot)</name>
  <description>Copilot agent that summarizes a Wikipedia article, exposed as a REST API.</description>

  <properties>
    <!-- The summarizer runs on java-25-jlib, the Ops-owned java-25 runtime plus jlib-inspector. -->
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Built by scripts/integrations/build.sh into the shared build/m2 repository. -->
    <copilot.integration.version>0.1.0-SNAPSHOT</copilot.integration.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.microsoft</groupId>
      <artifactId>copilot-spring-boot-starter</artifactId>
      <version>${copilot.integration.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- Traces and metrics over OTLP/HTTP; application.yml points them at the OpenTelemetry dashboard. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
