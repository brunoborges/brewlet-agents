<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The Copilot SDK integration is packed from the pinned copilot-sdk-integrations source by
         scripts/integrations/build.sh dotnet (scripts/integrations/languages/dotnet.sh). The path is relative
         to this file, so nothing here depends on the machine. -->
    <add key="integrations" value="../../build/integrations/dotnet" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="integrations">
      <package pattern="CopilotSdk.Extensions.Hosting" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
