<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.brunoborges.brewletagents</groupId>
  <artifactId>java-micronaut-concierge</artifactId>
  <version>1.0.0</version>
  <name>Runtime Concierge (Micronaut)</name>
  <description>Copilot agent that explains the Brewlet runtime it runs on.</description>

  <properties>
    <!-- The Ops-owned runtime is Java 25 (runtimes/java-25.env), so compile for it. -->
    <maven.compiler.release>25</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Reproducible thin jar: the same sources give the same bytes and so the same layer digest. -->
    <project.build.outputTimestamp>1980-02-01T00:00:00Z</project.build.outputTimestamp>
    <!-- Same Micronaut line as the integration's example. The processors are not managed by the BOM. -->
    <micronaut.platform.version>5.2.3</micronaut.platform.version>
    <micronaut.core.version>5.2.17</micronaut.core.version>
    <micronaut.serialization.version>3.2.5</micronaut.serialization.version>
    <copilot-sdk.version>2.0.1</copilot-sdk.version>
    <!-- Built by scripts/integrations/build.sh into the shared build/m2 repository. -->
    <copilot.integration.version>0.1.0-SNAPSHOT</copilot.integration.version>
    <main.class>io.github.brunoborges.brewletagents.concierge.ConciergeApplication</main.class>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.micronaut.platform</groupId>
        <artifactId>micronaut-platform</artifactId>
        <version>${micronaut.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.microsoft</groupId>
        <artifactId>copilot-sdk</artifactId>
        <version>${copilot-sdk.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.microsoft</groupId>
      <artifactId>copilot-micronaut</artifactId>
      <version>${copilot.integration.version}</version>
    </dependency>
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-http-server-netty</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micronaut.serde</groupId>
      <artifactId>micronaut-serde-jackson</artifactId>
    </dependency>
    <!-- Micronaut reads application.yml only when SnakeYAML is on the class path. -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>io.micronaut</groupId>
              <artifactId>micronaut-inject-java</artifactId>
              <version>${micronaut.core.version}</version>
            </path>
            <path>
              <groupId>io.micronaut.serde</groupId>
              <artifactId>micronaut-serde-processor</artifactId>
              <version>${micronaut.serialization.version}</version>
            </path>
            <path>
              <groupId>com.microsoft</groupId>
              <artifactId>copilot-micronaut-processor</artifactId>
              <version>${copilot.integration.version}</version>
            </path>
            <path>
              <groupId>com.microsoft</groupId>
              <artifactId>copilot-sdk</artifactId>
              <version>${copilot-sdk.version}</version>
            </path>
          </annotationProcessorPaths>
          <!-- Micronaut's processors plus the SDK's tool processor. The SDK jar also registers an
               experimental-API checker that would reject the tool processor's generated code, so every
               processor is named and that checker is left out. -->
          <annotationProcessors>
            <annotationProcessor>io.micronaut.annotation.processing.MixinVisitorProcessor</annotationProcessor>
            <annotationProcessor>io.micronaut.annotation.processing.PackageElementVisitorProcessor</annotationProcessor>
            <annotationProcessor>io.micronaut.annotation.processing.TypeElementVisitorProcessor</annotationProcessor>
            <annotationProcessor>io.micronaut.annotation.processing.AggregatingTypeElementVisitorProcessor</annotationProcessor>
            <annotationProcessor>io.micronaut.annotation.processing.BeanDefinitionInjectProcessor</annotationProcessor>
            <annotationProcessor>com.microsoft.copilot.tool.CopilotToolProcessor</annotationProcessor>
          </annotationProcessors>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
      </plugin>
      <!-- A thin jar: the manifest Class-Path points at lib/, which holds the dependency jars. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.10.0</version>
        <executions>
          <execution>
            <id>copy-libs</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
