# Single source of truth for every pinned version in this repository.
# Plain KEY=VALUE so it can be sourced by bash and included by make.
# Bumping a value here is how Ops "rotates" the platform; agents do not change.

# --- Brewlet -----------------------------------------------------------------
BREWLET_VERSION=0.11.0
BREWLET_CHART=oci://ghcr.io/microsoft/charts/brewlet

# --- Local cluster -----------------------------------------------------------
CLUSTER_NAME=brewlet-agents
REGISTRY_NAME=brewlet-agents-registry
REGISTRY_PORT=5001
REGISTRY_IMAGE=registry:2

# --- Copilot CLI (github/copilot-cli release) --------------------------------
# The out-of-process runtime every Copilot SDK talks to. It runs in one shared
# sidecar container (sidecars/copilot-cli); agent artifacts never contain it.
# The version is also the sidecar image tag written in every agents/*/deployment.yaml;
# `make check` fails until they match.
COPILOT_CLI_VERSION=1.0.114
# SHA-256 of github-copilot-<version>-linux-<arch>.tgz from the release's
# SHA256SUMS.txt. Pinned here so a sidecar build fails on any tampering.
COPILOT_CLI_SHA256_LINUX_ARM64=6ec2186c7bcd3da347588c66ebeca921b9568b804bb2c9c849644709ec33536c
COPILOT_CLI_SHA256_LINUX_X64=e9687515f6db23c05e5403fbe1f7f5283dfa58f77240bb61ac935bed39f31727

# --- Copilot SDKs (published packages) ---------------------------------------
COPILOT_SDK_JAVA_VERSION=2.0.1
COPILOT_SDK_NODE_VERSION=2.0.0
COPILOT_SDK_PYTHON_VERSION=2.0.1
COPILOT_SDK_DOTNET_VERSION=2.0.1

# --- Integrations (brunoborges/copilot-sdk-integrations) ---------------------
# Not published to any package registry yet, so scripts/integrations/build.sh
# builds them from this exact commit. Agents bundle the result into their own
# artifact; no runtime contains them.
INTEGRATIONS_REPO=brunoborges/copilot-sdk-integrations
INTEGRATIONS_SHA=262d47639c77a61ae8b35ab6087e6ef2e2f802f2

# --- Copilot CLI sidecar -----------------------------------------------------
SIDECAR_NAME=copilot-cli
SIDECAR_PORT=4321
SIDECAR_FETCH_IMAGE=alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f
SIDECAR_BASE_IMAGE=gcr.io/distroless/cc-debian13@sha256:809d04afa1be033c441f76bb0051878c342fb76d0ea236bc6dc94b655fa0fbd6

# --- Rotation demo (make rotate) ---------------------------------------------
# An older Microsoft Build of OpenJDK. demo/rotation lays it over the approved java-25 runtime to
# make the "before the patch" generation, so rotating to the approved image is a real JDK update.
# SHA-256 of microsoft-jdk-<version>-linux-<arch>.tar.gz from https://aka.ms/download-jdk/.
ROTATION_JDK_VERSION=25.0.4.1
ROTATION_JDK_SHA256_LINUX_ARM64=7c9eb1828d479dc9f546ba918a4c98593462bdb03fee404f9a63611ffffe546c
ROTATION_JDK_SHA256_LINUX_X64=d3b07dd6fd096353d6834e62a6f32117eb610d0bee24cb70acb8c82832043b68

# --- Agent contract ----------------------------------------------------------
# Namespace the agents run in, and the Secret that holds their tokens.
AGENT_NAMESPACE=agents
AGENT_SECRET=copilot-cli

# --- Observability stack (make observability) --------------------------------
# Namespace of the jlib-inspector server and dashboard and of the OpenTelemetry dashboard.
OBSERVABILITY_NAMESPACE=observability

# jlib-inspector (brunoborges/jlib-inspector, MIT): a Java agent that reports the libraries an
# application really loads, to a server (dashboard) and as OpenTelemetry log events.
#   - the agent jar is baked into the java-25-jlib runtime (runtimes/java-25-jlib),
#   - the server jar runs as apps/jlib-server on the plain java-25 runtime,
#   - the dashboard (apps/jlib-ui) is built from the source of the same release commit.
# SHA-256 of the jars attached to the GitHub release v<version>.
JLIB_INSPECTOR_VERSION=1.1.0
JLIB_INSPECTOR_COMMIT=b434984f11c206a5cee73353ccda9c77c0a299c3
JLIB_INSPECTOR_SHA256_AGENT=1e431d8c3d5bd40a361cd0bf497226139db49e1d05408a4de6913d64074b0367
JLIB_INSPECTOR_SHA256_SERVER=14cf234362add80682d784a34f6ff01def24c3c05d841d75ef86659249505d37

# OpenTelemetry dashboard: the standalone .NET Aspire Dashboard, which receives OTLP and shows
# logs, traces and metrics. Multi-arch index digest of the 13.6.5 tag, which is the tag that
# cluster/observability/otel-dashboard.yaml names; scripts/observability/deploy.sh applies the manifest
# with the image line replaced by this digest. OTEL_DASHBOARD is the name of that manifest's
# Deployment, Service and Secret.
OTEL_DASHBOARD=aspire-dashboard
OTEL_DASHBOARD_IMAGE=mcr.microsoft.com/dotnet/aspire-dashboard@sha256:e2b7cf9a4ead932de46c6fa2a289c7d6159cfcf06a51aa65f38253a8fae75407

# --- Documentation site (make docs) ------------------------------------------
# docs/requirements.txt pins the same release for pip; without mkdocs on the PATH, make docs runs
# this squidfunk/mkdocs-material image instead, so the site builds with only Docker installed.
MKDOCS_MATERIAL_VERSION=9.8.2
