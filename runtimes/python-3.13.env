RUNTIME_UID=65532
RUNTIME_GID=65532
ECOSYSTEM=python
ABI=glibc-2.41
MOUNT_PATHS=/tmp
DESCRIPTION=Python 3.13 (distroless, Debian 13)
INTERPRETER=/usr/bin/python3
