# Ops-owned runtime: plain ASP.NET Core 10 (framework-dependent apps), no Copilot SDK.
# Registered in the cluster by scripts/platform/runtime-register.sh; agents select it by id.
IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0-azurelinux3.0-distroless@sha256:74beeeaa6c913d19fde119911ba2fc0ffb183752cea28bf3b106d53de8c91ade
RUNTIME_UID=1654
RUNTIME_GID=1654
ECOSYSTEM=dotnet
ABI=glibc-2.38
MOUNT_PATHS=/tmp
DESCRIPTION=ASP.NET Core 10 runtime (Azure Linux 3.0 distroless)
INTERPRETER=/usr/bin/dotnet
