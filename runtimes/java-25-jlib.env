# Ops-owned runtime: java-25 with the jlib-inspector Java agent already attached.
# A derived runtime. It has no committed image: scripts/platform/runtime-build.sh lays the agent over the
# approved BASE image (runtimes/java-25.env), pushes the result to the local registry and
# scripts/platform/runtime-register.sh approves the digest that push produced. Agents and apps select it
# by id, exactly like java-25, and never carry the agent themselves.
BASE=java-25
CONTEXT=runtimes/java-25-jlib
RUNTIME_UID=101
RUNTIME_GID=101
ECOSYSTEM=java
ABI=glibc-2.38
MOUNT_PATHS=/tmp
DESCRIPTION=Microsoft Build of OpenJDK 25 (distroless) with the jlib-inspector agent
INTERPRETER=/usr/jdk/bin/java
